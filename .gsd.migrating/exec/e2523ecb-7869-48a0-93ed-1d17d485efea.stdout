319-    let mut disk_merge_data: DiskMergeData = None;
320-
321-    if cfg.monitored_paths != payload.monitored_paths {
322-        changed_fields.push("monitored_paths");
323-        cfg.monitored_paths = payload.monitored_paths.clone();
324-    }
325-    if cfg.heartbeat_interval_secs != Some(payload.heartbeat_interval_secs) {
326-        changed_fields.push("heartbeat_interval_secs");
327-        cfg.heartbeat_interval_secs = Some(payload.heartbeat_interval_secs);
328-    }
329-    if cfg.offline_cache_enabled != Some(payload.offline_cache_enabled) {
330-        changed_fields.push("offline_cache_enabled");
331-        cfg.offline_cache_enabled = Some(payload.offline_cache_enabled);
332-    }
333-    if cfg.ldap_config != payload.ldap_config {
334-        changed_fields.push("ldap_config");
335-        cfg.ldap_config = payload.ldap_config.clone();
336-    }
337-    if cfg.excluded_paths != payload.excluded_paths {
338-        changed_fields.push("excluded_paths");
339-        cfg.excluded_paths = payload.excluded_paths.clone();
340-    }
