641-/// The main service run loop.
642-///
643-/// Runs the file system event loop and the service control loop.
644-/// All other subsystems (IPC servers, health monitor, session monitor, UI
645-/// spawner) run on blocking std threads started in [`run_service`].
646-///
647-/// When the SCM issues `sc stop`, [`password_stop::initiate_stop`] starts the
648-/// password challenge.  This loop polls the confirmation flag every 500 ms — on
649-/// confirmation it proceeds to shutdown; on `PASSWORD_CANCEL` or max attempts,
650-/// [`password_stop::revert_stop`] reverts the state to Running.
651-async fn run_loop(
652-    status_handle: &Arc<Mutex<windows_service::service_control_handler::ServiceStatusHandle>>,
653-    machine_name: Option<String>,
654-) -> Result<()> {
655-    // ── Open the audit log ────────────────────────────────────────────────
656-    let _log_path = crate::audit_emitter::log_path();
657-    info!(audit_log = %_log_path.display(), "audit subsystem initialised");
658-
659-    // Initialise all subsystems and collect handles into a single context.
660-    let ctx = run_loop_init(machine_name).await;
661-
662-    // ── Service control loop ─────────────────────────────────────────────
663-    let poll_interval = Duration::from_millis(500);
664-    let mut ticker = tokio::time::interval(poll_interval);
665-
666-    crate::password_stop::debug_log("run_loop: entering service control loop");
667-

=== run_loop_shutdown ===
1262:async fn run_loop_shutdown(ctx: RunLoopContext) {
1263-    crate::password_stop::debug_log("run_loop: starting graceful shutdown");
1264-    info!(
1265-        service_name = SERVICE_NAME,
1266-        "shutting down enforcement subsystems"
1267-    );
1268-
1269-    // Uninstall the drag-and-drop hook (APP-08, Phase 40).
1270-    crate::password_stop::debug_log("run_loop: uninstalling drag-drop hook");
1271-    crate::interception::uninstall_drag_drop_hook();
1272-    crate::password_stop::debug_log("run_loop: drag-drop hook uninstalled");
1273-
1274-    // Stop the file monitor first so no new events arrive.
1275-    crate::password_stop::debug_log("run_loop: stopping file monitor");
1276-    ctx.file_monitor.stop();
1277-    let _ = ctx.file_handle.await;
1278-    crate::password_stop::debug_log("run_loop: file monitor stopped");
1279-
1280-    // Signal the event loop to drain and exit.
1281-    drop(ctx.event_loop_handle);
1282-    crate::password_stop::debug_log("run_loop: event loop dropped");
1283-
1284-    // Stop the heartbeat loop.
1285-    let _ = ctx.heartbeat_shutdown_tx.send(true);
1286-    let _ = ctx.heartbeat_handle.await;
1287-    crate::password_stop::debug_log("run_loop: heartbeat stopped");
1288-
1289-    // Stop the Pipe 1 heartbeat.
1290-    let _ = ctx.pipe1_shutdown_tx.send(true);
1291-    let _ = ctx.pipe1_hb_handle.await;
1292-    crate::password_stop::debug_log("run_loop: Pipe 1 heartbeat stopped");
1293-
1294-    // Stop the config poll loop.
1295-    let _ = ctx.config_shutdown_tx.send(true);
1296-    if let Some(h) = ctx.config_poll_handle {
1297-        let _ = h.await;
1298-    }
1299-    crate::password_stop::debug_log("run_loop: config poll stopped");
1300-
1301-    // Stop the device registry poll task.
1302-    let _ = ctx.registry_shutdown_tx.send(true);

