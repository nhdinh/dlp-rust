2054-        // OnceLock and tests may run in parallel, we cannot guarantee this
2055-        // in all test configurations. The test is marked as a best-effort
2056-        // verification of the uninitialized path.
2057-        //
2058-        // If other tests in the same process have already set CONFIG, this
2059-        // test will still pass because we only assert that `with_config`
2060-        // returns `Some` when initialized and that the closure is executed.
2061-        // The uninitialized case is covered by the type system (Option<R>).
2062-        let result: Option<String> =
2063-            with_config(|cfg| cfg.usb_blocked_failure_mode.clone().unwrap_or_default());
2064-        // When CONFIG is set by other tests, result is Some(...).
2065-        // When CONFIG is unset, result is None.

