501:                    // Phase 37 (T-37-13): apply_payload_to_config runs INSIDE the
502-                    // config lock scope and returns any disk_merge_data needed for
503-                    // the deferred instance_id_map merge. The map merge must happen
504-                    // AFTER the config lock is released (lock-order invariant).
505-                    let (changed_fields, disk_merge_data) = {
506-                        let mut cfg = config.lock();
507:                        apply_payload_to_config(&mut cfg, &payload)
508-                    };
509-                    // cfg lock is now released. Safe to access instance_id_map.
510-
511-                    // Apply deferred disk_allowlist merge into DiskEnumerator.
512-                    if let Some((old_ids, new_list)) = disk_merge_data {
513-                        if let Some(enumerator) = crate::detection::disk::get_disk_enumerator() {
514-                            merge_disk_allowlist_into_map(&enumerator, &old_ids, &new_list);
515-                        }
516-                    }
517-
518-                    if !changed_fields.is_empty() {
519-                        // Log field names only — never log path values (T-06-09 info disclosure).
520-                        info!(
521-                            fields = ?changed_fields,
522-                            "agent config updated from server"
523-                        );
524-                        // Write back to TOML for persistence across restarts.
525-                        // Use the effective path (DLP_CONFIG_PATH env var if set, else
526-                        // DEFAULT_CONFIG_PATH) so integration tests can redirect to a
527-                        // temp directory without touching the production config file.
528-                        let effective_path =
529-                            crate::config::AgentConfig::effective_config_path();
530-                        let config_path = std::path::Path::new(&effective_path);
531-                        let cfg = config.lock();
532-                        if let Err(e) = cfg.save(config_path) {
533-                            tracing::error!(
534-                                error = %e,
535-                                "failed to write updated config to TOML"
536-                            );
537-                        }
